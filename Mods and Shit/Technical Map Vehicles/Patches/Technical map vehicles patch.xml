<?xml version="1.0" encoding="utf-8" ?>
<Patch>              



<!-- Dreadnought / Heavy platform truck -->
                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleBuildDef[defName="Dreadnought_Blueprint"]/label</xpath>
                    <value>
                        <label>Heavy platform truck</label>
                    </value>
                </Operation>

                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleBuildDef[defName="Dreadnought_Blueprint"]/description</xpath>
                    <value>
                        <description>A heavy-duty truck with a vast building platform on its bed, perfect for mounting weapons or transporting large amounts of equipment or other vehicles.</description>
                    </value>
                </Operation>

                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleBuildDef[defName="Dreadnought_Blueprint"]/researchPrerequisites</xpath>
                    <value>
                        <researchPrerequisites><li>Ferny_HeavyPlatformTruck</li></researchPrerequisites>
                    </value>
                </Operation>

                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleDef[defName="TMC_Dreadnought"]/label</xpath>
                    <value>
                        <label>Heavy platform truck</label>
                    </value>
                </Operation>

                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleDef[defName="TMC_Dreadnought"]/description</xpath>
                    <value>
                        <description>A heavy-duty truck with a vast building platform on its bed, perfect for mounting weapons or transporting large amounts of equipment or other vehicles.</description>
                    </value>
                </Operation>

                <Operation Class="PatchOperationFindMod">
                    <mods>
                    <li>Vehicle Interior Framework</li>
                    </mods>
                    <match Class="PatchOperationSequence">
                    <operations>
                        <li Class="PatchOperationReplace">
                        <success>Always</success>
                        <xpath>Defs/ResearchProjectDef[defName="Ferny_HeavyPlatformTruck"]/prerequisites</xpath>
                        <value>
                        <prerequisites>
                            <li>Ferny_Motorhome</li>
                        </prerequisites>
                        </value>
                        </li>
                    </operations>
                    </match>
                </Operation>





