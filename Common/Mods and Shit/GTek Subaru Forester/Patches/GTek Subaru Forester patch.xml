                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleDef[defName="HID_98Forester"]/label</xpath>
                    <value>
                        <label>station wagon</label>
                    </value>
                </Operation>

                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleDef[defName="HID_98Forester"]/description</xpath>
                    <value>
                        <description>A five-seat station wagon with all-wheel drive. It handles rough roads and icy ground better than a typical passenger car.</description>
                    </value>
                </Operation>



