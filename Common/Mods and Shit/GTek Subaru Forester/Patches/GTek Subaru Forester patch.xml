<?xml version="1.0" encoding="utf-8"?>
<Patch>              

<!-- Research -->

                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleBuildDef[defName="HID_98Forester_Blueprint"]/researchPrerequisites</xpath>
                    <value>
                        <researchPrerequisites><li>Ferny_BasicCar</li></researchPrerequisites>
                    </value>
                </Operation>

<!-- normal -->
                <Operation Class="PatchOperationReplace">
                    <xpath>/Defs/Vehicles.VehicleBuildDef[defName="HID_98Forester_Blueprint"]/label</xpath>
                    <value>
