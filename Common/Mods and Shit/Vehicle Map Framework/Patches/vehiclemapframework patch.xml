<?xml version="1.0" encoding="utf-8" ?>
<Patch>              


<!-- Wireless power transmitter -->

<Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VMF_WirelessTransmitter"]/label</xpath>
    <value>
        <label>wireless platform power transmitter</label>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VMF_WirelessTransmitter"]/description</xpath>
    <value>
		<description>A device for transmitting and recieving power onto a vehicle platform. Vehicles can park over the transmitter to recieve power wirelessly. Must be placed on the ground.</description>
    </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="VMF_WirelessTransmitter"]/researchPrerequisites</xpath>
    <value>
    	<researchPrerequisites>
            <li>Ferny_PlatformLogistics</li>
		</researchPrerequisites>
    </value>
</Operation>

