  <ResearchProjectDef>
    <defName>Ferny_FieldCarrier</defName>
    <label>Field carrier</label>
    <description>Build a large truck meant to deliver troops and supplies away from the base. It can move well in rough terrain, but the fuel efficiency is low, and passengers in the back will lack protection.</description>
    <baseCost>1500</baseCost>
    <tab>Vehicles</tab>
    <techLevel>Industrial</techLevel>
    <researchViewX>3.00</researchViewX>
    <researchViewY>1.50</researchViewY>
    <prerequisites>
      <li>VVE_ComplexVehicles</li>
    </prerequisites>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>Ferny_LightTank</defName>
    <label>Light tank</label>
    <description>Build a small tank with light armor. It's very cheap and easy to assemble, but very loud and vulnerable in the rear. They aren't very fast or accurate and use a lot of fuel, and are best used in short-range engagements.</description>
    <baseCost>1200</baseCost>
    <tab>Vehicles</tab>
    <techLevel>Industrial</techLevel>
    <researchViewX>4.00</researchViewX>
    <researchViewY>1.50</researchViewY>
    <prerequisites>
      <li>Ferny_FieldCarrier</li>
    </prerequisites>
  </ResearchProjectDef>

